# eslint-plugin-jsx-a11y@6.10.2 (its latest release) still declares a peer
# range capping at eslint 9, while this project runs eslint 10. npm 7+ treats
# that unmet peer as a hard error and re-checks the whole tree on every
# install, so without this ANY `npm install` here fails — including a plain
# clone-and-install by someone who has changed nothing.
#
# The plugin works correctly under eslint 10; the declaration is stale, not
# the compatibility. Revisit once jsx-a11y publishes a release that lists
# eslint 10 as a supported peer, then delete this file.
legacy-peer-deps=true
