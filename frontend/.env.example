# Copy to `.env.local` (gitignored) to point this build at a backend.
#
# Leaving it unset is a supported configuration, not a broken one: the tablet is
# the source of truth and every flow works with no network at all (ADR-001).
# Without it the app runs offline-only — writes still queue in the outbox, so
# setting this later pushes the whole accumulated history rather than starting
# from empty.
#
# No trailing slash; `/api/...` is appended to it.
VITE_RACKIN_API_URL=http://localhost:8080

# Shared key the backend expects, matching RACKIN_API_KEY in
# backend/config/local.properties. Both are required: a URL without a key would
# send the whole queue and collect a 401 on every record, and since a 4xx is
# treated as permanent that would mark the gym's entire history as rejected.
#
# This is not a secret from whoever holds the tablet — it ships in the bundle
# and devtools reveals it. It closes the API to the internet, which is what a
# browser client can honestly achieve.
VITE_RACKIN_API_KEY=
